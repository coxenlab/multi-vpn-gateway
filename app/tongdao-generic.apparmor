#include <tunables/global>
profile tongdao-generic flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  signal,
  ptrace (trace,read,tracedby,readby) peer=tongdao-generic,
  # systemd 的服务沙箱先把根与 /dev 设为 slave propagation，避免沙箱内的后续
  # mount 传播回容器根命名空间。只放行传播属性调整，不授权新的文件系统挂载。
  mount options=(rw,rslave) -> /,
  mount options=(rw,rshared) -> /,
  mount options=(rw,slave) -> /run/systemd/incoming/,
  mount options=(rw,rslave) -> /dev/,
  # systemd.exec 的私有凭据与文件系统命名空间。目标固定在 systemd 自己的 staging
  # 目录；不允许在 /tmp 或其他任意路径新建 tmpfs/bind mount。
  mount fstype=ramfs options=(rw,nosuid,nodev,noexec) ramfs -> /dev/shm/,
  mount fstype=tmpfs options=(rw,nosuid,nodev,noexec) tmpfs -> /dev/shm/,
  mount options=(rw,rbind) /run/credentials/** -> /dev/shm/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /dev/shm/,
  mount options=(rw,move) /dev/shm/ -> /run/credentials/**,
  mount options=(rw,rbind) / -> /run/systemd/unit-root/,
  mount options=(ro,remount,bind) -> /run/systemd/unit-root/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/home/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/root/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/run/credentials/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/run/user/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/run/systemd/**,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/proc/**,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/sys/**,
  mount options=(rw,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/proc/,
  mount options=(ro,nosuid,nodev,noexec,remount,bind) -> /run/systemd/unit-root/sys/,
  mount options=(ro,noexec,remount,bind) -> /run/systemd/unit-root/sys/**,
  mount options=(rw,rbind) /run/systemd/unit-root/** -> /run/systemd/unit-root/**,
  mount options=(rw,rbind) /run/systemd/inaccessible/** -> /run/systemd/unit-root/**,
  mount fstype=proc options=(rw,nosuid,nodev,noexec) proc -> /run/systemd/unit-root/proc/,
  mount options=(rw,bind) /run/systemd/propagate/** -> /run/systemd/unit-root/run/systemd/incoming/,
  mount options=(rw,rbind) /run/systemd/inhibit/ -> /run/systemd/unit-root/run/systemd/inhibit/,
  mount options=(rw,rbind) /run/systemd/seats/ -> /run/systemd/unit-root/run/systemd/seats/,
  mount options=(rw,rbind) /run/systemd/sessions/ -> /run/systemd/unit-root/run/systemd/sessions/,
  mount options=(rw,rbind) /run/systemd/users/ -> /run/systemd/unit-root/run/systemd/users/,
  mount options=(rw,rbind) /run/systemd/shutdown/ -> /run/systemd/unit-root/run/systemd/shutdown/,
  mount options=(rw,rbind) /tmp/systemd-private-*-*.service-*/tmp/ -> /run/systemd/unit-root/tmp/,
  mount options=(rw,rbind) /var/tmp/systemd-private-*-*.service-*/tmp/ -> /run/systemd/unit-root/var/tmp/,
  mount options=(rw,rbind) /var/lib/systemd/linger/ -> /run/systemd/unit-root/var/lib/systemd/linger/,
  umount /run/systemd/unit-root/**,
  mount options=(rw,move) /run/systemd/unit-root/ -> /,
  mount options=(rw,nosuid,nodev,noexec,remount,relatime) -> /sys/fs/cgroup/,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
